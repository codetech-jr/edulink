# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role Key (Requerido exclusivamente en el servidor para tareas administrativas como sincronización BCV y solicitudes de inscripción)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Job Secret (Utilizado por Vercel Cron y endpoints protegidos de sincronización /api/bcv-sync)
CRON_SECRET=

